#!/bin/sh

set -eu

remote_name="${1:-origin}"
zero_sha="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  case "${remote_ref}" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  if [ "${local_sha}" = "${zero_sha}" ]; then
    continue
  fi

  base_sha="${remote_sha}"
  if [ "${base_sha}" = "${zero_sha}" ]; then
    base_sha="$(git merge-base "${local_sha}" "${remote_name}/main" 2>/dev/null || true)"
  fi

  if [ -z "${base_sha}" ]; then
    echo "[pre-push] Unable to resolve a remote base for ${remote_ref}." >&2
    exit 1
  fi

  echo "[pre-push] Checking playback contracts for ${base_sha}...${local_sha}"
  node scripts/check-playback-change-gates.mjs --base "${base_sha}"
done
